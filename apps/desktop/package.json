{
  "name": "@draftpredict/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "npm run build && node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@draftpredict/server": "*"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "description": "DraftPredict desktop shell: Electron window, tray, champ-select overlay and the embedded server",
  "exports": {
    "./renderer": {
      "types": "./src/renderer.d.ts"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    }
  }
}
