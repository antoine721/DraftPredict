# Riot Games API key (https://developer.riotgames.com) — required only for
# account lookup, match history, playstyle and live-game features.
# The League client integration (real-time champ select) works WITHOUT a key.
RIOT_API_KEY=

# Default platform for account lookups (euw1, na1, kr, ...)
DRAFTPREDICT_PLATFORM=euw1

# Server port (web UI is served from here in production)
PORT=4700

# Optional: force LCU connection details (debugging only)
# DRAFTPREDICT_LCU_PORT=
# DRAFTPREDICT_LCU_TOKEN=
