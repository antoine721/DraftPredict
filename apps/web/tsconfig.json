{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist-types",
        "rootDir": "src",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "noEmit": false,
        "emitDeclarationOnly": true,
        "types": ["vite/client"],
        "baseUrl": ".",
        "paths": { "@/*": ["./src/*"] }
    },
    "include": ["src/**/*"],
    "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/testing/**",
        "dist",
        "dist-types"
    ],
    "references": [
        { "path": "../../packages/core" },
        { "path": "../../packages/riot" },
        { "path": "../../packages/lcu" }
    ]
}
